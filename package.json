{
	"name": "Play YouTube Video In Background",
	"version": "1.1.0",
	"author": "Labinator",
	"type": "module",
	"description": "Prevents YouTube & Vimeo from stopping Firefox from playing videos in the background.",
	"repository": {
		"type": "git",
		"url": "https://github.com/LabinatorSolutions/play-youtube-video-in-background.git"
	},
	"homepage": "https://github.com/LabinatorSolutions/play-youtube-video-in-background",
	"bugs": {
		"url": "https://github.com/LabinatorSolutions/play-youtube-video-in-background/issues"
	},
	"scripts": {
		"lint": "eslint . --report-unused-disable-directives --max-warnings 0",
		"lint:fix": "eslint . --fix",
		"typecheck": "tsc --noEmit",
		"test": "bun run lint && bun run typecheck",
		"prebuild": "bun run test",
		"build": "web-ext build --overwrite-dest",
		"validate": "web-ext lint",
		"preview": "echo 'No Preview'"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/firefox-webext-browser": "^143.0.0",
		"bun-types": "latest",
		"eslint": "^10.8.1",
		"globals": "^17.11.0",
		"typescript": "^7.0.2",
		"web-ext": "^10.6.0"
	},
	"private": true
}